# Copy to .env for local development. Every value has a sensible default.

# Postgres connection string. Leave empty to use the embedded PGlite database in ./data (local dev only).
DATABASE_URL=

# Random string used to sign session cookies. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000
# Set to "production" on the host so cookies are marked Secure.
NODE_ENV=development

# Game configuration (see PRD section 13). Defaults shown.
PROFESSOR_NAME=Professor Brenner
CLASS_NAME=AM215
GUESS_MIN=0
GUESS_MAX=50
LOCK_AFTER_SEC=600
DEFAULT_DURATION_SEC=4500
PROJECTION_TAU_SEC=600
PROJECTION_MIN_ELAPSED_SEC=120
# Weak stabiliser from the crowd's median guess, used only until the first lecture has finished. 0 disables.
PROJECTION_CROWD_TAU_SEC=60
ELO_K_NEW=48
ELO_K=32
ELO_NEW_SESSIONS=5
ELO_START=1000
RATING_DECAY_ENABLED=false

# Seed script: password given to every seeded account.
SEED_PASSWORD=specs-demo-2026
